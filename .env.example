# Placeholder configuration for the IceClaw RUNTIME (not for any coding assistant).
# Copy to .env only if you need live investigations; never overwrite an existing .env.
# Never commit real credentials. Recorded replay, verification and downloads need none of these.

# Live investigations (Microsoft Agent Framework + OpenAI). The project uses the model gpt-6-luna.
ICECLAW_LLM_PROVIDER=openai
ICECLAW_LLM_MODEL=
OPENAI_API_KEY=

# Local storage (defaults shown; both folders are ignored by Git)
ICECLAW_DATA_ROOT=./data/processed
ICECLAW_RUNS_ROOT=./runs

# Optional source locations (defaults: .upstream/moonatlas-science/examples/science-smoke and
# data/sombench/prospectivity_dataset)
# ICECLAW_MOONATLAS_ROOTS=
# ICECLAW_SOMBENCH_ROOT=
